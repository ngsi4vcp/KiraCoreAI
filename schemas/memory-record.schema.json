{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ngsi4vcp/KiraCoreAI/schemas/memory-record.schema.json",
  "title": "Запись памяти Кира:Ядра",
  "type": "object",
  "required": ["id", "type", "content", "timestamp", "source", "importance", "provenance", "status"],
  "properties": {
    "id": {"type": "string"},
    "type": {"enum": ["FACT", "RELATIONSHIP", "EVENT", "DECISION", "EXPERIENCE", "DISCOVERY", "HYPOTHESIS"]},
    "content": {"type": "string"},
    "timestamp": {"type": "string"},
    "source": {"type": "string"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "importance": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {"type": "string"},
    "entities": {"type": "array", "items": {"type": "string"}},
    "valid_from": {"type": ["string", "null"]},
    "valid_to": {"type": ["string", "null"]},
    "status": {"enum": ["candidate", "approved", "cancelled"]}
  },
  "additionalProperties": false
}
